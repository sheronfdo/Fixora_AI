# Fixora AI Service — copy to .env and fill in. NEVER commit the real .env.

ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key      # server-only, never shipped to clients
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret             # Supabase → Project Settings → API → JWT secret

# OpenRouter (OpenAI-compatible LLM gateway)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini             # swap freely, e.g. anthropic/claude-3.5-sonnet, google/gemini-flash-1.5
OPENROUTER_SITE_URL=https://fixora.app
OPENROUTER_APP_NAME=Fixora

# Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# CORS (comma-separated, or * for any)
CORS_ORIGINS=*
